        {
          "refId": "A",
          "expr": "sum by (skills, outcome) (rate(bijou_bank_generations_total[5m]))",
          "legendFormat": "{{skills}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Bank generation latency",
      "description": "Skill bank generation duration.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
