      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skills) (rate(bijou_agent_skill_picks_total[5m])) * 60",
          "legendFormat": "{{skills}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
