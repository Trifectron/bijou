      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bijou_bank_lock_wait_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Bank tokens per second",
      "description": "Positions the skill bank generated per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bijou_bank_tokens_total[5m]))",
          "legendFormat": "tok/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Trained skills",
      "description": "Skills with a trained adapter loaded in the bank.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(bijou_bank_trained_skills)",
          "legendFormat": "skills",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Bank load seconds",
      "description": "Time the bank took to load its checkpoint and adapters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(bijou_bank_load_seconds)",
          "legendFormat": "load",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Inference (llama-server)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
        "h": 1
      },
      "id": 19
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Generation throughput",
      "description": "Tokens the server actually produced per wall-clock second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 59
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:tokens_predicted_total{job=~\"$job\"}[1m])",
          "legendFormat": "{{job}} tok/s"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Prompt throughput",
      "description": "Prompt tokens evaluated per second, excluding tokens served from the prompt cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 59
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:prompt_tokens_total{job=~\"$job\"}[1m])",
          "legendFormat": "{{job}} new tok/s"
        },
        {
          "refId": "B",
          "expr": "rate(llamacpp:prompt_tokens_cached_total{job=~\"$job\"}[1m])",
          "legendFormat": "{{job}} cached tok/s"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Queue",
      "description": "Deferred above zero means requests are waiting for a slot. This is the saturation signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 67
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "fillOpacity": 20,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:requests_processing{job=~\"$job\"}",
          "legendFormat": "{{job}} processing"
        },
        {
          "refId": "B",
          "expr": "llamacpp:requests_deferred{job=~\"$job\"}",
          "legendFormat": "{{job}} deferred"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Batching efficiency",
      "description": "Average busy slots per decode. Near 1 with a non-empty queue means --parallel is too low.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 67
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:n_busy_slots_per_decode{job=~\"$job\"}",
          "legendFormat": "{{job}} busy slots"
        },
        {
          "refId": "B",
          "expr": "rate(llamacpp:n_decode_total{job=~\"$job\"}[1m])",
          "legendFormat": "{{job}} decodes/s"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Server-reported speed",
      "description": "llama-server's own running average for the last requests, independent of load.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:predicted_tokens_seconds{job=~\"$job\"}",
          "legendFormat": "{{job}} generation tok/s"
        },
        {
          "refId": "B",
          "expr": "llamacpp:prompt_tokens_seconds{job=~\"$job\"}",
          "legendFormat": "{{job}} prompt tok/s"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Prompt cache hit rate",
      "description": "Share of prompt tokens reused from cache. A long stable system prompt should keep this high.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:prompt_tokens_cached_total{job=~\"$job\"}[5m]) / clamp_min(rate(llamacpp:prompt_tokens_cached_total{job=~\"$job\"}[5m]) + rate(llamacpp:prompt_tokens_total{job=~\"$job\"}[5m]), 0.001)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Context ceiling",
      "description": "llamacpp:n_tokens_max - the largest context the server will accept, per slot.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:n_tokens_max{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "GPU",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 83,
        "w": 24,
        "h": 1
      },
      "id": 27
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "GPU utilisation",
      "description": "Fraction of time the GPU was executing a kernel. Sustained low utilisation under load means the bottleneck is elsewhere.",
      "datasource": {
