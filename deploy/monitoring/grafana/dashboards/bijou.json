      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, purpose) (rate(bijou_agent_model_call_seconds_bucket[5m])))",
          "legendFormat": "{{purpose}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
