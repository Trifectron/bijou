# Secrets and per-machine paths only. Every tunable lives in bijou.toml.

# Point at a config outside the repo.
#BIJOU_CONFIG_FILE=

# Override a machine-specific device without editing bijou.toml.
#BIJOU_BACKEND__DEVICE=cuda

# Weights and Biases, if you use it.
#WANDB_API_KEY=

# ---- harness: the chat model (llama-server) and the browser MCP server
BIJOU_HARNESS__LLM__BASE_URL=http://127.0.0.1:8000/v1
BIJOU_HARNESS__LLM__API_KEY=
# BIJOU_HARNESS__MCP__PLAYWRIGHT_URL=http://127.0.0.1:8931/mcp
# ---- collect: the teacher model that writes skill data
BIJOU_COLLECT__BASE_URL=http://127.0.0.1:8000/v1
BIJOU_COLLECT__API_KEY=
